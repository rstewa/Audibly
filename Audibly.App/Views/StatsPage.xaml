<?xml version="1.0" encoding="utf-8" ?>

<Page
    mc:Ignorable="d"
    x:Class="Audibly.App.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userControls="using:Audibly.App.UserControls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style TargetType="Border" x:Key="StatsCardStyle">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,16,20,18" />
        </Style>
        <Style
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock"
            x:Key="StatsEyebrowStyle">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="CharacterSpacing" Value="120" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock"
            x:Key="StatsValueLabelStyle">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style
            BasedOn="{StaticResource SubtitleTextBlockStyle}"
            TargetType="TextBlock"
            x:Key="StatsValueStyle">
            <Setter Property="FontSize" Value="24" />
        </Style>
    </Page.Resources>

    <!--  The panel gets an explicit width from the viewport: with MaxWidth alone it is placed
          off-center whenever its content is narrower than that maximum.  -->
    <ScrollViewer SizeChanged="Viewport_SizeChanged" VerticalScrollBarVisibility="Auto">
        <StackPanel
            HorizontalAlignment="Center"
            Padding="36,36,36,200"
            SizeChanged="Content_SizeChanged"
            Spacing="20"
            x:Name="ContentPanel">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Listening statistics" />

            <!--  Current title and all-time totals  -->
            <Grid ColumnSpacing="16" RowSpacing="16" x:Name="CardsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource StatsCardStyle}" x:Name="CurrentCard">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource StatsEyebrowStyle}" Text="CURRENT TITLE" />
                        <TextBlock
                            MaxLines="2"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            x:Name="CurrentTitleText" />
                        <Grid ColumnSpacing="24" x:Name="CurrentValues">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatsValueLabelStyle}" Text="Listened" />
                                <TextBlock
                                    AutomationProperties.AutomationId="CurrentListenedText"
                                    Style="{StaticResource StatsValueStyle}"
                                    x:Name="CurrentListenedText" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource StatsValueLabelStyle}" Text="Time saved" />
                                <TextBlock
                                    AutomationProperties.AutomationId="CurrentSavedText"
                                    Style="{StaticResource StatsValueStyle}"
                                    x:Name="CurrentSavedText" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Style="{StaticResource StatsCardStyle}"
                    x:Name="TotalCard">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource StatsEyebrowStyle}" Text="ALL TIME" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            x:Name="TotalSinceText" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatsValueLabelStyle}" Text="Listened" />
                                <TextBlock
                                    AutomationProperties.AutomationId="TotalListenedText"
                                    Style="{StaticResource StatsValueStyle}"
                                    x:Name="TotalListenedText" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource StatsValueLabelStyle}" Text="Time saved" />
                                <TextBlock
                                    AutomationProperties.AutomationId="TotalSavedText"
                                    Style="{StaticResource StatsValueStyle}"
                                    x:Name="TotalSavedText" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Shown instead of the chart until something has been listened to  -->
            <TextBlock
                AutomationProperties.AutomationId="StatsEmptyText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"
                Margin="0,32,0,32"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="No listening recorded yet. Play an audiobook and your statistics will appear here."
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="Collapsed"
                x:Name="EmptyText" />

            <StackPanel Spacing="12" x:Name="ChartSection">
                <SelectorBar
                    AutomationProperties.AutomationId="StatsPeriodSelector"
                    HorizontalAlignment="Center"
                    SelectionChanged="PeriodSelector_SelectionChanged"
                    x:Name="PeriodSelector">
                    <SelectorBarItem
                        IsSelected="True"
                        Text="Daily"
                        x:Name="DailyItem" />
                    <SelectorBarItem Text="Monthly" x:Name="MonthlyItem" />
                    <SelectorBarItem Text="Yearly" x:Name="YearlyItem" />
                </SelectorBar>

                <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource StatsEyebrowStyle}"
                        x:Name="AverageEyebrowText" />
                    <TextBlock
                        AutomationProperties.AutomationId="AverageText"
                        FontSize="34"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        x:Name="AverageText" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        x:Name="RangeText" />
                </StackPanel>

                <userControls:StatsBarChart x:Name="Chart" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                Margin="0,16,0,0"
                Spacing="2">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource StatsEyebrowStyle}"
                    Text="IN MY LIBRARY" />
                <TextBlock
                    AutomationProperties.AutomationId="LibraryCountText"
                    FontSize="34"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    x:Name="LibraryCountText" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
