<?xml version="1.0" encoding="utf-8" ?>

<Page
    Background="Transparent"
    mc:Ignorable="d"
    x:Class="Audibly.App.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:userControls="using:Audibly.App.UserControls"
    xmlns:vm="using:Audibly.App.ViewModels"
    xmlns:winUi="using:CommunityToolkit.WinUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  ReSharper disable all Xaml.RedundantResource  -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <!--  TitleBar  -->
            <RowDefinition Height="*" />
            <!--  NavView  -->
        </Grid.RowDefinitions>

        <Border
            AutomationProperties.AutomationId="NowPlayingAppTitleBar"
            Canvas.ZIndex="1"
            Grid.Column="1"
            Height="48"
            IsHitTestVisible="True"
            Margin="80,0,0,0"
            VerticalAlignment="Stretch"
            x:Name="NowPlayingAppTitleBar" />

        <Grid
            Canvas.ZIndex="0"
            Grid.Column="1"
            Grid.RowSpan="2">
            <!--  backdrop  -->
            <Grid>
                <Border BorderBrush="Transparent" BorderThickness="0">
                    <Border.Background>
                        <ImageBrush ImageSource="{x:Bind PlayerViewModel.NowPlaying.CoverImagePath, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <media:UIElementExtensions.VisualFactory>
                    <media:PipelineVisualFactory Source="{media:BackdropSource}">
                        <media:BlurEffect Amount="50" />
                    </media:PipelineVisualFactory>
                </media:UIElementExtensions.VisualFactory>
            </Grid>

            <!--  got this from RiseMediaPlayer: https://github.com/Rise-Software/Rise-Media-Player  -->
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border.Background>
                    <AcrylicBrush
                        FallbackColor="Transparent"
                        TintColor="{Binding Color, Source={ThemeResource OverlayBackgroundBrush}}"
                        TintOpacity="0.7" />
                </Border.Background>
            </Border>

            <Grid Padding="24,16,24,20" RowSpacing="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button RequestedTheme="Dark" Click="BackButton_OnClick" IsEnabled="{x:Bind Frame.CanGoBack, Mode=OneWay}"
                        Style="{StaticResource NavigationBackButtonNormalStyle}" ToolTipService.ToolTip="Back" x:Name="BackButton"/>
                    <TextBlock Text="Now playing" RequestedTheme="Dark" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Row="1" Height="300" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind vm:Converters.CollapsedIf(PlayerViewModel.ReadAlongEnabled), Mode=OneWay}">
                    <Border CornerRadius="{StaticResource OverlayCornerRadius}">
                        <Border.Background>
                            <ImageBrush ImageSource="{x:Bind PlayerViewModel.NowPlaying.CoverImagePath, Mode=OneWay}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <winUi:Effects.Shadow><media:AttachedCardShadow CornerRadius="{StaticResource OverlayCornerRadiusDouble}" Offset="4, 4"/></winUi:Effects.Shadow>
                </Border>
                <userControls:ReadAlongPanel Grid.Row="1" x:Name="ReadAlong" Visibility="{x:Bind PlayerViewModel.ReadAlongEnabled, Mode=OneWay}"/>
                <userControls:PlayerControlGrid Grid.Row="2" RequestedTheme="Dark" ShowCoverImage="False"/>
            </Grid>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="TitleBarStates">
                <VisualState x:Name="Default" />
                <VisualState x:Name="Compact">
                    <VisualState.Setters>
                        <Setter Target="NowPlayingAppTitleBar.Margin" Value="80,0,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Top">
                    <VisualState.Setters>
                        <Setter Target="NowPlayingAppTitleBar.Margin" Value="80,0,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="WindowActivationStates">
                <VisualState x:Name="Activated" />
                <VisualState x:Name="Deactivated">
                    <VisualState.Setters>
                        <Setter Target="NowPlayingAppTitleBar.Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
