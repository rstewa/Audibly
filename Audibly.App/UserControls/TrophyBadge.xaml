<?xml version="1.0" encoding="utf-8" ?>

<UserControl
    mc:Ignorable="d"
    x:Class="Audibly.App.UserControls.TrophyBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  A round badge: greyed out while locked, filled with a bronze, silver or gold ring once unlocked.  -->
    <Button
        Background="Transparent"
        BorderThickness="0"
        Click="Badge_Click"
        CornerRadius="8"
        HorizontalAlignment="Center"
        Padding="12,10,12,10"
        x:Name="BadgeButton">
        <StackPanel Spacing="8" Width="126">
            <Grid
                Height="110"
                HorizontalAlignment="Center"
                Width="110">
                <!--  locked  -->
                <Ellipse
                    Stroke="{ThemeResource TextFillColorDisabledBrush}"
                    StrokeThickness="3"
                    x:Name="LockedRing" />
                <!--  unlocked  -->
                <Ellipse x:Name="UnlockedDisc">
                    <Ellipse.Fill>
                        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                            <GradientStop Color="{ThemeResource SystemAccentColorDark3}" Offset="0" />
                            <GradientStop Color="{ThemeResource SystemAccentColorDark1}" Offset="0.55" />
                            <GradientStop Color="{ThemeResource SystemAccentColorLight1}" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse StrokeThickness="5" x:Name="TierRing" />
                <FontIcon
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="44"
                    Foreground="{ThemeResource TextFillColorDisabledBrush}"
                    x:Name="LockedIcon" />
                <FontIcon
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="44"
                    Foreground="White"
                    x:Name="UnlockedIcon" />
            </Grid>
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                x:Name="NameText" />
        </StackPanel>
    </Button>
</UserControl>
